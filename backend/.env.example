# Amazon RDS (PostgreSQL) connection details
# Copy this file to ".env" and fill in your real RDS instance details.
# Find these in the AWS Console under RDS > Databases > your-db-instance.

RDS_HOST=your-db-instance.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=cloudorbit
RDS_USER=cloudorbit_admin
RDS_PASSWORD=your-strong-password
RDS_SSL=true

# Server
PORT=4000

# Comma separated list of origins allowed to call this API
# e.g. https://cloudorbit.fun,https://www.cloudorbit.fun
CORS_ORIGIN=https://cloudorbit.fun
